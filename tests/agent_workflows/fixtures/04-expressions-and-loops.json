{
  "name": "expressions-and-loops",
  "description": "Expression conditions covering every operator, an edge label, a two-way edge via `back`, and goTo with `back`.",
  "ops": [
    {
      "op": "converse",
      "id": "triage",
      "prompt": "Find out what the caller needs"
    },
    {
      "op": "converse",
      "at": "triage",
      "when": {
        "llm": "Caller has a general question",
        "label": "General"
      },
      "back": "Question answered",
      "id": "faq",
      "prompt": "Answer from the FAQ"
    },
    {
      "op": "converse",
      "at": "triage",
      "id": "vip",
      "prompt": "Offer the VIP service",
      "when": {
        "expr": {
          "type": "or_operator",
          "children": [
            {
              "type": "eq_operator",
              "left": {
                "type": "dynamic_variable",
                "name": "tier"
              },
              "right": {
                "type": "string_literal",
                "value": "gold"
              }
            },
            {
              "type": "and_operator",
              "children": [
                {
                  "type": "gte_operator",
                  "left": {
                    "type": "dynamic_variable",
                    "name": "orders"
                  },
                  "right": {
                    "type": "number_literal",
                    "value": 10
                  }
                },
                {
                  "type": "neq_operator",
                  "left": {
                    "type": "dynamic_variable",
                    "name": "churn_risk"
                  },
                  "right": {
                    "type": "boolean_literal",
                    "value": false
                  }
                }
              ]
            }
          ]
        }
      }
    },
    {
      "op": "converse",
      "at": "triage",
      "id": "refund",
      "prompt": "Process the refund",
      "when": {
        "label": "Large refund",
        "expr": {
          "type": "gt_operator",
          "left": {
            "type": "mul_operator",
            "left": {
              "type": "dynamic_variable",
              "name": "unit_price"
            },
            "right": {
              "type": "dynamic_variable",
              "name": "quantity"
            }
          },
          "right": {
            "type": "conditional_operator",
            "condition": {
              "type": "eq_operator",
              "left": {
                "type": "dynamic_variable",
                "name": "region"
              },
              "right": {
                "type": "null_literal"
              }
            },
            "trueExpression": {
              "type": "number_literal",
              "value": 500
            },
            "falseExpression": {
              "type": "sub_operator",
              "left": {
                "type": "number_literal",
                "value": 1000
              },
              "right": {
                "type": "div_operator",
                "left": {
                  "type": "dynamic_variable",
                  "name": "discount"
                },
                "right": {
                  "type": "add_operator",
                  "left": {
                    "type": "number_literal",
                    "value": 1
                  },
                  "right": {
                    "type": "number_literal",
                    "value": 1
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "op": "goTo",
      "at": "refund",
      "when": {
        "expr": {
          "type": "lte_operator",
          "left": {
            "type": "dynamic_variable",
            "name": "attempts"
          },
          "right": {
            "type": "number_literal",
            "value": 3
          }
        }
      },
      "target": "triage"
    },
    {
      "op": "goTo",
      "at": "vip",
      "target": "faq",
      "back": "Caller wants VIP service again"
    },
    {
      "op": "end",
      "at": "faq",
      "when": {
        "expr": {
          "type": "lt_operator",
          "left": {
            "type": "llm",
            "value_schema": {
              "type": "number",
              "description": "How satisfied is the caller, from 1 to 10?"
            }
          },
          "right": {
            "type": "number_literal",
            "value": 5
          }
        }
      }
    }
  ],
