      "prevent_subagent_loops": false,
      "nodes": {
        "start_node": {
          "type": "start",
          "position": {
            "x": 40,
            "y": 60
          },
          "edge_order": [
            "e1"
          ]
        },
        "node_a1": {
          "type": "override_agent",
          "label": "Identify",
          "additional_prompt": "Ask for the order number",
          "position": {
            "x": 40,
            "y": 260
          },
          "edge_order": [
            "e3",
            "e2"
          ]
        },
        "node_b2": {
          "type": "tool",
          "tools": [
            {
              "tool_id": "tool_get_order"
            }
          ],
          "position": {
            "x": 40,
            "y": 460
          },
          "edge_order": [
            "e4"
          ]
        },
        "node_c3": {
          "type": "override_agent",
          "label": "Resolve",
          "additional_prompt": "Explain the order status",
          "position": {
            "x": 40,
            "y": 660
          },
          "edge_order": []
        },
        "node_d4": {
          "type": "phone_number",
