            "type": "phone",
            "phone_number": "+15550000000"
          },
          "position": {
            "x": 340,
            "y": 260
          },
          "edge_order": []
        }
      },
      "edges": {
        "e1": {
          "source": "start_node",
          "target": "node_a1",
          "forward_condition": {
            "type": "unconditional"
          }
        },
        "e2": {
          "source": "node_a1",
          "target": "node_b2",
          "forward_condition": {
            "type": "llm",
            "condition": "Caller gave an order number"
          }
        },
        "e3": {
          "source": "node_a1",
          "target": "node_d4",
          "forward_condition": {
            "type": "llm",
            "condition": "Caller wants a human"
          }
        },
        "e4": {
          "source": "node_b2",
          "target": "node_c3",
          "forward_condition": {
            "type": "result",
            "successful": true
          }
        }
      }
    }
  },
  "ops": [
    {
      "op": "update",
      "node": "node_c3",
      "options": {
        "prompt": "Explain the status, then offer a discount code",
        "label": "Resolve and retain"
      }
    },
    {
      "op": "update",
      "node": "node_b2",
      "options": {
        "toolIds": [
          "tool_get_order",
          "tool_get_loyalty"
        ]
      }
    },
    {
      "op": "insertBetween",
      "source": "node_a1",
      "target": "node_b2",
      "ops": [
        {
          "op": "converse",
          "id": "verify",
          "prompt": "Verify the caller's identity with a one-time code"
        },
        {
          "op": "tool",
          "when": "Caller read out the code",
          "id": "check_code",
          "toolIds": [
            "tool_check_otp"
          ]
        }
      ]
    },
    {
      "op": "remove",
      "node": "node_d4"
    },
    {
      "op": "transfer",
      "at": "node_a1",
      "when": "Caller wants a human",
      "id": "human",
      "destination": {
        "agent": "agent_tier2"
      }
    },
    {
      "op": "end",
      "at": "node_c3",
      "when": "Caller is satisfied"
    }
  ],
  "expected": {
